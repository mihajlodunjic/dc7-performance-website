---
interface Props {
  compact?: boolean;
  showName?: boolean;
  class?: string;
  disabled?: boolean;
}

const { compact = false, showName = true, class: className = "", disabled = false } = Astro.props;
---

<a
  href={disabled ? undefined : "/"}
  class:list={["wordmark", compact && "wordmark--compact", className]}
  aria-label="DC7 Performance — Dejan Nikolić"
  aria-disabled={disabled ? "true" : undefined}
>
  <span class="wordmark__mark">DC<span class="wordmark__seven">7</span></span>
  {showName && !compact && (
    <>
      <span class="wordmark__divider" aria-hidden="true"></span>
      <span class="wordmark__name">DEJAN NIKOLIĆ</span>
    </>
  )}
</a>
