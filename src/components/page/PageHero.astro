---
import type { ImageMetadata } from "astro";
import Breadcrumbs from "@components/global/Breadcrumbs.astro";
import DissolveImage from "@components/photography/DissolveImage.astro";

interface Crumb {
  name: string;
  href: string;
}

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  ctaLabel?: string;
  ctaHref?: string;
  meta?: string;
  breadcrumbs?: Crumb[];
  image?: ImageMetadata;
  imageAlt?: string;
  imagePosition?: string;
  imageMobilePosition?: string;
}

const {
  eyebrow,
  title,
  intro,
  ctaLabel,
  ctaHref,
  meta,
  breadcrumbs,
  image,
  imageAlt = "",
  imagePosition = "50% 50%",
  imageMobilePosition = imagePosition
} = Astro.props;
---

<section class:list={["page-hero", image && "page-hero--with-image"]}>
  <div class="page-hero__inner">
    <div class="page-hero__copy" data-reveal>
      {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="lead">{intro}</p>
      {(ctaLabel && ctaHref) && (
        <a class="button button--primary" href={ctaHref}>
          {ctaLabel}
        </a>
      )}
      {meta && <p class="page-hero__meta">{meta}</p>}
    </div>
    {image && (
      <DissolveImage
        class="page-hero__image"
        src={image}
        alt={imageAlt}
        fade="left-bottom"
        aspect="4 / 5"
        mobileAspect="16 / 13"
        position={imagePosition}
        mobilePosition={imageMobilePosition}
        widths={[360, 540, 720, 900, 1080]}
        sizes="(max-width: 760px) 100vw, 42vw"
      />
    )}
  </div>
</section>
