---
import BaseLayout from "@layouts/BaseLayout.astro";
import SectionIndex from "@components/global/SectionIndex.astro";
import DissolveImage from "@components/photography/DissolveImage.astro";
import CapabilityRows from "@components/performance/CapabilityRows.astro";
import ProcessLine from "@components/performance/ProcessLine.astro";
import SportRows from "@components/performance/SportRows.astro";
import CaseStudyStrip from "@components/performance/CaseStudyStrip.astro";
import { business, instagramCta } from "@data/business";
import { homeCapabilities, processSteps } from "@data/performanceAreas";
import { sportRows } from "@data/sports";
import heroImage from "../assets/images/dejan/dejan-hero-barbell.jpeg";
import deadliftImage from "../assets/images/dejan/dejan-deadlift-back.jpeg";
import kettlebellImage from "../assets/images/dejan/dejan-kettlebell-profile.jpeg";
import medicineImage from "../assets/images/dejan/dejan-medicine-ball.jpeg";
---

<BaseLayout
  title="DC7 Performance | Dejan Nikolić — kondicioni trener Beograd"
  description="Kondiciona priprema sportista sa Dejanom Nikolićem: brzina, prvi korak, snaga, eksplozivnost, agilnost, testiranje i individualni razvoj."
  path="/"
>
  <section class="home-hero" aria-labelledby="home-hero-title">
    <div class="home-hero__inner">
      <div class="home-hero__copy" data-reveal>
        <p class="eyebrow">DC7 PERFORMANCE / DEJAN NIKOLIĆ</p>
        <h1 id="home-hero-title">Trening za ono što se dešava na terenu.</h1>
        <p class="lead">Kondiciona priprema sportista kroz razvoj brzine, prvog koraka, snage, eksplozivnosti, agilnosti i sposobnosti da telo podnese zahteve konkretnog sporta.</p>
        <div class="home-hero__actions">
          <a class="button button--primary" href={business.instagramUrl} target="_blank" rel="noreferrer">{instagramCta.consultation}</a>
          <a class="text-link" aria-disabled="true">Pogledaj metod rada</a>
        </div>
        <p class="metadata home-hero__metadata">SPORTSKA PERFORMANSA / INDIVIDUALNI RAZVOJ / BEOGRAD</p>
      </div>
      <DissolveImage
        class="home-hero__image"
        src={heroImage}
        alt="Dejan Nikolić tokom treninga sa šipkom"
        fade="left-bottom"
        aspect="5 / 6"
        mobileAspect="4 / 5"
        position="58% 46%"
        mobilePosition="52% 40%"
        loading="eager"
        fetchpriority="high"
        widths={[360, 540, 720, 960, 1200, 1440]}
        sizes="(max-width: 900px) 100vw, 56vw"
      />
    </div>
  </section>

  <section class="site-section assessment" aria-labelledby="assessment-title">
    <div class="section-grid" data-reveal>
      <SectionIndex label="01 / PROCENA" />
      <h2 id="assessment-title" class="assessment__title">Ne počinjemo od programa. Počinjemo od sportiste.</h2>
      <div class="assessment__text">
        <p class="lead">Košarkaš, fudbaler, teniser i rukometaš nemaju iste zahteve. Razlikuju se i sportisti unutar istog sporta. Zato trening treba da krene od onoga što sportista trenutno može, onoga što mu nedostaje i onoga što njegov sport od njega traži.</p>
        <p>Procena služi da se odrede prioriteti. Nekome je to prvi korak. Nekome sposobnost da koči i ponovo ubrza. Nekome snaga, stabilnost ili održavanje visokog intenziteta. Trening dobija smisao tek kada je jasno šta se razvija i zašto.</p>
        <a class="text-link" aria-disabled="true">Kako izgleda metod rada</a>
      </div>
      <div class="assessment__axis" aria-hidden="true">
        <span>Sport</span>
        <span>Stanje</span>
        <span>Prioritet</span>
        <span>Doza</span>
      </div>
    </div>
  </section>

  <section class="site-section development" aria-labelledby="development-title">
    <div class="section-grid" data-reveal>
      <SectionIndex label="02 / RAZVOJ" />
      <div class="development__intro">
        <h2 id="development-title">Sposobnosti koje treba da rade zajedno.</h2>
        <p class="lead">Cilj nije jedna bolja brojka u teretani. Cilj je kompletniji sportista koji može da proizvede silu, kontroliše pokret, promeni pravac, ponovi intenzivnu akciju i kvalitetno nastavi proces treninga.</p>
        <a class="text-link" aria-disabled="true">Pogledaj kompletan metod</a>
      </div>
      <div class="development__rows">
        <CapabilityRows items={homeCapabilities} />
      </div>
    </div>
  </section>

  <section class="editorial-break" aria-label="Sport specifičan pristup">
    <DissolveImage
      class="editorial-break__image"
      src={deadliftImage}
      alt="Dejan Nikolić tokom vežbe sa opterećenjem u trening prostoru"
      fade="right-bottom"
      aspect="16 / 11"
      mobileAspect="4 / 5"
      position="54% 54%"
      mobilePosition="52% 45%"
      widths={[540, 720, 960, 1200, 1600]}
      sizes="(max-width: 900px) 100vw, 62vw"
    />
    <div class="editorial-break__quote" data-reveal>
      <p>Fudbaler, atletičar i rukometaš ne treba da treniraju po istom šablonu.</p>
      <p>Zahtev sporta određuje šta ima prioritet.</p>
    </div>
  </section>

  <section class="site-section process" aria-labelledby="process-title">
    <div class="section-grid" data-reveal>
      <SectionIndex label="03 / PROCES" />
      <div class="process__copy">
        <h2 id="process-title">Proceni. Postavi prioritet. Treniraj. Prati. Prilagodi.</h2>
        <p class="lead">Program nije završen dokument koji se slepo ponavlja. Sportista se menja, sezona se menja, opterećenje se menja — zato se menja i ono što trening treba da reši.</p>
        <a class="text-link" aria-disabled="true">Pogledaj testiranje sportista</a>
      </div>
      <div class="process__line">
        <ProcessLine steps={processSteps} />
      </div>
    </div>
  </section>

  <section class="site-section sports" aria-labelledby="sports-title">
    <div class="section-grid" data-reveal>
      <SectionIndex label="04 / SPORT" />
      <div class="sports__copy">
        <h2 id="sports-title">Ista osnova. Drugačiji zahtevi.</h2>
        <p class="lead">Brzina, snaga i eksplozivnost postoje u gotovo svakom sportu, ali se ne ispoljavaju na isti način. Kondiciona priprema mora da prati stvarne situacije u kojima će sportista te sposobnosti koristiti.</p>
        <a class="text-link" href={business.instagramUrl} target="_blank" rel="noreferrer">Razgovaraj o svom sportu</a>
      </div>
      <div class="sports__rows">
        <SportRows items={sportRows} />
      </div>
    </div>
  </section>

  <section class="site-section progress" aria-labelledby="progress-title">
    <div class="section-grid" data-reveal>
      <SectionIndex label="05 / NAPREDAK" />
      <div class="progress__copy">
        <h2 id="progress-title">Napredak se prati. Ne pretpostavlja.</h2>
        <p class="lead">Testiranje i praćenje imaju smisla kada pomažu da se sledeća odluka u treningu donese na osnovu stvarnog stanja sportiste, a ne samo osećaja nakon jednog treninga.</p>
        <p>Tokom procesa prati se kako sportista napreduje, kako podnosi opterećenje i koliko je spreman za sledeći korak. Rezultat nije samo koliko je neko podigao u teretani, već koliko su razvijene sposobnosti korisne u njegovom sportu.</p>
        <a class="text-link" aria-disabled="true">Kako funkcioniše testiranje</a>
      </div>
      <p class="progress__index" aria-hidden="true">TEST / TRAIN / TRACK / ADAPT</p>
    </div>
    <CaseStudyStrip />
  </section>

  <section class="site-section coach" aria-labelledby="coach-title">
    <div class="section-grid" data-reveal>
      <DissolveImage
        class="coach__image"
        src={kettlebellImage}
        alt="Dejan Nikolić sa kettlebellom u trening prostoru"
        fade="right-bottom"
        aspect="4 / 5"
        mobileAspect="4 / 5"
        position="52% 40%"
        mobilePosition="50% 36%"
        widths={[360, 540, 720, 900, 1080]}
        sizes="(max-width: 900px) 100vw, 42vw"
      />
      <div class="coach__copy">
        <SectionIndex label="06 / COACH" />
        <h2 id="coach-title">Iskustvo sa obe strane treninga.</h2>
        <p class="lead">Dejan Nikolić je diplomirani profesor fizičkog vaspitanja, kondicioni trener i bivši profesionalni košarkaš.</p>
        <p>Pre trenerskog rada prošao je kroz takmičarski sport iz perspektive igrača, a danas radi na razvoju fizičkih sposobnosti sportista različitih sportova i nivoa. Deo profesionalnog rada obavlja kao kondicioni trener u Player Zone Tennis Academy u Beogradu.</p>
        <p>U svom radu kombinuje formalno obrazovanje, Strength & Conditioning edukaciju, iskustvo profesionalnog sporta i praktičan rad sa mladim sportistima, profesionalnim igračima i reprezentativcima.</p>
        <div class="coach__links">
          <a class="text-link" aria-disabled="true">Više o Dejanu</a>
          <a class="text-link" href={business.instagramUrl} target="_blank" rel="noreferrer">{business.instagramHandle} <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="contact-band" aria-labelledby="contact-title">
    <div class="contact-band__inner" data-reveal>
      <div class="contact-band__copy">
        <SectionIndex label="07 / KONTAKT" />
        <h2 id="contact-title">Prvi korak je da utvrdimo šta ti trenutno najviše treba.</h2>
        <p class="lead">Ako želiš ozbiljniju fizičku pripremu za svoj sport, pošalji poruku sa kratkim opisom sporta kojim se baviš, trenutnog nivoa i onoga što želiš da unaprediš.</p>
        <a class="button button--primary" href={business.instagramUrl} target="_blank" rel="noreferrer">{instagramCta.consultation}</a>
        <p class="contact-band__meta">Instagram / {business.instagramHandle}</p>
      </div>
      <DissolveImage
        class="contact-band__image"
        src={medicineImage}
        alt="Dejan Nikolić tokom vežbe sa medicinkom"
        fade="left-bottom"
        aspect="4 / 5"
        mobileAspect="4 / 5"
        position="50% 42%"
        mobilePosition="50% 36%"
        widths={[360, 540, 720, 900, 1080]}
        sizes="(max-width: 900px) 100vw, 38vw"
      />
    </div>
  </section>
</BaseLayout>
